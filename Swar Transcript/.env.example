# SwarTranscript AI - Frontend Environment Variables
# Copy this file to .env and configure your Supabase details:
# Note: Never commit actual keys or .env to version control.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key

# Server-Side Secrets:
# Configure these in your Supabase Project Settings -> Edge Functions -> Secrets:
# - APIFY_API_TOKEN : Apify API Token for streamers/youtube-scraper
# - GROQ_API_KEY    : Groq API Key for AI Toolkit (llama-3.3-70b-versatile)
